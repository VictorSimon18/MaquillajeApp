# Copia este archivo a .env.local y rellena los valores desde
# Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Solo necesaria para `npm run seed:catalog` (scripts/seed-catalog.ts).
# NUNCA la uses en código de cliente ni la expongas con el prefijo
# NEXT_PUBLIC_ — salta Row Level Security por completo.
# Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
